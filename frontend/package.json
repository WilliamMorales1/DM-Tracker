  },
  "devDependencies": {
    "@types/marked": "^4.3.2",
    "@types/node": "^26.6.6",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
